# =====================================================================
# Git Ignore for Jeevanta / Hackathon Full-Stack Application
# =====================================================================

# ─── Compiled Java Bytecode & Build Artifacts ────────────────────────
target/
build/
dist/
bin/
*.class
*.war
*.jar

# ─── Node.js & React Frontend ─────────────────────────────────────────
**/node_modules/
**/build/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Environment & Secrets ───────────────────────────────────────────
.env
.env.*
!.env.example
*.pem
*.key

# ─── IDE & Editor Metadata ───────────────────────────────────────────
.idea/
.settings/
.classpath
.project
*.iml
*.iws
*.ipr
nbproject/private/
.vscode/

# ─── Backup & Internal Git ───────────────────────────────────────────
*.backup
*.bak
.git_backup/
**/.git_backup/

# ─── Operating System & Temp Files ───────────────────────────────────
.DS_Store
Thumbs.db
*.tmp
*.swp
